# Копирайте като .env и попълнете.
SECRET_KEY=generate-a-long-random-string
WEB_CONCURRENCY=2
WORKER_THREADS=40
DB_POOL_SIZE=40

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Демо режим без реален AI (когато няма ключ)
AI_MOCK=1

MAX_UPLOAD_MB=20
